<resources>
    <style
        name="Theme.BestBidderTCG"
        parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Primary brand color -->
        <item name="colorPrimary">@color/bb_primary</item>
        <item name="colorPrimaryVariant">@color/bb_primary</item>
        <item name="colorOnPrimary">@color/bb_surface</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/bb_accent</item>
        <item name="colorSecondaryVariant">@color/bb_accent</item>
        <item name="colorOnSecondary">@color/bb_surface</item>

        <!-- Window background -->
        <item name="android:windowBackground">@color/bb_background</item>

        <!-- System status bar -->
        <item name="android:statusBarColor">@color/bb_background</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- System navigation bar -->
        <item name="android:navigationBarColor">@color/bb_background</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
